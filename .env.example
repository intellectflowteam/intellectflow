# ── Supabase (required) ─────────────────────────────────────────────
# Get these from your own Supabase project: Project Settings → API
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxx"
SUPABASE_URL="https://your-project-ref.supabase.co"
# Same values, exposed to the browser (Vite requires the VITE_ prefix)
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxx"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Server-only — bypasses Row Level Security. Never expose to the client.
# Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxx"

# ── AI features (review writer, replies, FAQ, SWOT, sentiment) ─────
# Any OpenAI-compatible provider works out of the box (OpenAI, OpenRouter,
# Groq, Together, a self-hosted vLLM/Ollama endpoint, etc). Set these once
# you've picked one — until then, the AI buttons in the app will error.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1/chat/completions"
AI_MODEL="gpt-4o-mini"

# ── Google Places (business search, competitor auto-fetch) ─────────
# https://console.cloud.google.com/google/maps-apis — enable "Places API"
GOOGLE_API_KEY=""

# ── Misc ─────────────────────────────────────────────────────────────
# Shared secret for the /api/public/rating-drop-alert cron endpoint
CRON_SECRET=""
